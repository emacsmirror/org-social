;;; vfile support

;; Forward declaration: the minor mode is defined below.
(defvar org-social-mode)

(defvar org-social-file--upload-state (make-hash-table :test #'equal)
  "Upload state of each vfile local copy, keyed by its expanded path.
Each value is a plist with :status (nil, `uploading', `failed' or
`conflict'), :started (`float-time' when the running upload began),
:pending (vfile URL of an upload requested while another one was
running) and :conflict-file (the last conflict copy).")

(defvar org-social-file--inhibit-sync nil
  "When non-nil, saving the vfile local copy does not upload it.")

(defconst org-social-file--upload-timeout 60
  "Seconds after which a running upload is considered lost.")

(defconst org-social-file--no-cache-headers
  '(("Cache-Control" . "no-cache")
    ("Pragma" . "no-cache"))
  "HTTP headers asking caches between Emacs and the host to revalidate.")

(defun org-social-file--is-vfile-p (file-path)
  "Check if FILE-PATH is a vfile URL (http:// or https://)."
  (and (stringp file-path)
       (let ((path (string-trim file-path)))
         (or (string-prefix-p "http://" path)
             (string-prefix-p "https://" path)))))

(defun org-social-file--schemeless-url-p (file-path)
  "Return non-nil if FILE-PATH looks like a URL that lost its scheme.
For example \"host.org-social.org/vfile?token=...\"."
  (and (stringp file-path)
       (let ((path (string-trim file-path)))
         (and (not (org-social-file--is-vfile-p path))
              (not (string-match-p "\\`[~/.]" path))
              (or (string-match-p "/vfile\\?" path)
                  (string-match-p
                   (concat "\\`[[:alnum:]-]+\\(?:\\.[[:alnum:]-]+\\)*"
                           "\\.[[:alpha:]]\\{2,\\}\\(?::[0-9]+\\)?/")
                   path))))))

(defun org-social-file--vfile-url-problem (vfile-url)
  "Return a string describing what is wrong with VFILE-URL, or nil if valid.
A vfile URL looks like https://HOST/vfile?token=TOKEN&ts=SECONDS&sig=SIG,
in any parameter order, where TOKEN and SIG are 64 lowercase hexadecimal
characters, as generated by the host.  Checking their exact length
detects a URL copied only partially.  Surrounding whitespace is ignored."
  (let* ((parsed (url-generic-parse-url (string-trim vfile-url)))
         (path-and-query (url-path-and-query parsed))
         (path (or (car path-and-query) ""))
         (query (cdr path-and-query))
         (params (and query (url-parse-query-string query)))
         (hex64-p (lambda (name)
                    (let ((value (cadr (assoc name params)))
                          (case-fold-search nil))
                      (and value (string-match-p "\\`[0-9a-f]\\{64\\}\\'" value))))))
    (cond
     ((not (member (url-type parsed) '("http" "https")))
      "it must start with https://")
     ((or (null (url-host parsed)) (string-empty-p (url-host parsed)))
      "it has no host")
     ((string-suffix-p ".org" path)
      "this is the public URL of your feed, not the vfile URL (https://HOST/vfile?token=...&ts=...&sig=...)")
     ((not (string-suffix-p "/vfile" path))
      "its path must end with /vfile")
     ((or (null query) (string-empty-p query))
      "the ?token=...&ts=...&sig=... part is missing")
     ((not (funcall hex64-p "token"))
      "the token parameter is missing or truncated")
     ((not (string-match-p "\\`[0-9]+\\'" (or (cadr (assoc "ts" params)) "")))
      "the ts parameter is missing or not a number")
     ((not (funcall hex64-p "sig"))
      "the sig parameter is missing or truncated"))))

(defun org-social-file--check-config ()
  "Signal a `user-error' if `org-social-file' cannot be used.
Catches URLs pasted without their scheme, which would otherwise be
treated as a local file and never uploaded, and incomplete vfile URLs."
  ;; URLs are often pasted with surrounding spaces or newlines
  (when (stringp org-social-file)
    (setq org-social-file (string-trim org-social-file)))
  (when (and (boundp 'org-social-my-public-url) (stringp org-social-my-public-url))
    (setq org-social-my-public-url (string-trim org-social-my-public-url)))
  (when (org-social-file--schemeless-url-p org-social-file)
    (user-error "Variable `org-social-file' looks like a URL without \"https://\": %s.  Add \"https://\" at the beginning"
                org-social-file))
  (when (org-social-file--is-vfile-p org-social-file)
    (let ((problem (org-social-file--vfile-url-problem org-social-file)))
      (when problem
        (user-error "The vfile URL is invalid or incomplete (%s), copy it again from your other client"
                    problem)))
    (unless (and (boundp 'org-social-my-public-url)
                 (stringp org-social-my-public-url)
                 (not (string-empty-p org-social-my-public-url)))
      (user-error "Variable `org-social-my-public-url' must be set to use a vfile"))))

(defun org-social-file--extract-host-from-vfile (vfile-url)
  "Extract the host base URL from VFILE-URL.
Returns the scheme://host[:port] part of the URL."
  (when (org-social-file--is-vfile-p vfile-url)
    (let ((parsed-url (url-generic-parse-url vfile-url)))
      (if (and (url-portspec parsed-url)
               (/= (url-port parsed-url)
                   (if (equal (url-type parsed-url) "https") 443 80)))
          (format "%s://%s:%d"
                  (url-type parsed-url)
                  (url-host parsed-url)
                  (url-port parsed-url))
        (format "%s://%s"
                (url-type parsed-url)
                (url-host parsed-url))))))

(defun org-social-file--get-local-file-path (_vfile-url)
  "Get the local file path for a vfile.
Returns path to v-social.org or v-social-ACCOUNT.org in `user-emacs-directory'.
When using multi-account mode, each account gets its own cache file.
_VFILE-URL is ignored but kept for API compatibility."
  (let ((account-name (when (boundp 'org-social-accounts--current)
                        org-social-accounts--current)))
    (if account-name
        ;; Multi-account mode: use account-specific file
        (expand-file-name (format "v-social-%s.org" account-name) user-emacs-directory)
      ;; Single-account mode: use default file
      (expand-file-name "v-social.org" user-emacs-directory))))

;;;; Local copy and the remote version it is based on

(defun org-social-file--sha256 (content)
  "Return the SHA-256 hex digest of the string CONTENT encoded as UTF-8."
  (secure-hash 'sha256 (encode-coding-string content 'utf-8-unix)))

(defun org-social-file--read-local (path)
  "Return the contents of PATH decoded as UTF-8, or nil if it does not exist."
  (when (file-exists-p path)
    (with-temp-buffer
      (let ((coding-system-for-read 'utf-8-unix))
        (insert-file-contents path))
      (buffer-substring-no-properties (point-min) (point-max)))))

(defun org-social-file--write-local (path content)
  "Write the string CONTENT to PATH as UTF-8 with LF line endings."
  (with-temp-file path
    (insert content)
    (set-buffer-file-coding-system 'utf-8-unix)))

(defun org-social-file--base-file (local-path)
  "Return the file that remembers the remote version of LOCAL-PATH."
  (concat local-path ".etag"))

(defun org-social-file--read-base (local-path)
  "Return the remote version LOCAL-PATH was last synchronized with.
The value is a plist (:etag ETAG :sha256 HASH :content CONTENT), where
CONTENT may be missing in files written by older versions, ETAG may be nil
when the host sent none, or nil when the version is unknown."
  (let ((file (org-social-file--base-file local-path)))
    (when (file-readable-p file)
      (condition-case nil
          (with-temp-buffer
            (let ((coding-system-for-read 'utf-8-unix))
              (insert-file-contents file))
            (let ((base (read (current-buffer))))
              (when (and (listp base) (stringp (plist-get base :sha256)))
                base)))
        (error nil)))))

(defun org-social-file--write-base (local-path etag content)
  "Remember that LOCAL-PATH matches the remote CONTENT served with ETAG.
The ETag, a SHA-256 of CONTENT and CONTENT itself are stored next to
LOCAL-PATH so they survive Emacs restarts."
  (with-temp-file (org-social-file--base-file local-path)
    (set-buffer-file-coding-system 'utf-8-unix)
    (let ((print-escape-newlines t))
      (prin1 (list :etag etag
                   :sha256 (org-social-file--sha256 content)
                   :content content)
             (current-buffer)))
    (insert "\n")))

;;;; HTTP

(defun org-social-file--no-cache-url (url)
  "Return URL with a `_t' query parameter that defeats stale caches."
  (format "%s%s_t=%d" url (if (string-search "?" url) "&" "?")
          (truncate (* 1000 (float-time)))))

(defun org-social-file--parse-response ()
  "Parse the HTTP response in the current buffer.
Return a plist (:status CODE :etag ETAG :body BODY), where BODY is
decoded as UTF-8.  CODE is nil if there is no HTTP status line."
  (save-excursion
    (goto-char (point-min))
    (let* ((header-end (and (re-search-forward "\r?\n\r?\n" nil t) (point)))
           (status nil)
           (etag nil)
           (case-fold-search t))
      (goto-char (point-min))
      (when (re-search-forward "^HTTP/[0-9.]+ \\([0-9]+\\)" header-end t)
        (setq status (string-to-number (match-string 1))))
      (goto-char (point-min))
      (when (re-search-forward "^etag:[ \t]*\\([^\r\n]*?\\)[ \t]*\r?$" header-end t)
        (setq etag (match-string-no-properties 1)))
      (list :status status
            :etag (and etag (not (string-empty-p etag)) etag)
            :body (if header-end
                      (decode-coding-string
                       (buffer-substring-no-properties header-end (point-max))
                       'utf-8)
                    "")))))

(defun org-social-file--response-ok-p (response)
  "Return non-nil if RESPONSE has a 2xx HTTP status."
  (let ((status (plist-get response :status)))
    (and status (>= status 200) (< status 300))))

(defvar-local org-social-file--skip-http-auth nil
  "Non-nil in url.el buffers whose 401 answers go straight to the callback.")
(put 'org-social-file--skip-http-auth 'permanent-local t)

(defun org-social-file--skip-http-auth (orig-fun &rest args)
  "Around advice of `url-http-handle-authentication'.
In requests made by `org-social-file--url-retrieve', return t so that
url.el gives the 401 answer to the callback, instead of asking for a
user and password (or storing empty credentials and sending them to
every later request to the host).  Otherwise call ORIG-FUN with ARGS."
  (if org-social-file--skip-http-auth
      t
    (apply orig-fun args)))

(defun org-social-file--url-retrieve (url callback)
  "Retrieve URL silently with `url-retrieve' and call CALLBACK.
A 401 answer reaches CALLBACK like any other HTTP error: the host uses
it for an invalid vfile, which no user and password can fix."
  (unless (advice-member-p #'org-social-file--skip-http-auth
                           'url-http-handle-authentication)
    (advice-add 'url-http-handle-authentication :around
                #'org-social-file--skip-http-auth))
  (let ((buffer (url-retrieve url callback nil t)))
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (setq org-social-file--skip-http-auth t)))
    buffer))

(defun org-social-file--fetch-remote (url callback)
  "Fetch URL asynchronously, bypassing caches.
Call CALLBACK with the plist of `org-social-file--parse-response', or
with nil if the host could not be reached."
  (let ((url-request-method "GET")
        (url-request-data nil)
        (url-request-noninteractive t)
        (url-request-extra-headers org-social-file--no-cache-headers))
    (org-social-file--url-retrieve
     (org-social-file--no-cache-url url)
     (lambda (_status)
       (let ((response (condition-case nil
                           (org-social-file--parse-response)
                         (error nil))))
         (kill-buffer (current-buffer))
         (funcall callback (and (plist-get response :status) response)))))))

(defun org-social-file--fetch-remote-sync (url)
  "Fetch URL synchronously, bypassing caches.
Return the plist of `org-social-file--parse-response', or nil if the
host could not be reached."
  (condition-case err
      (let* ((url-request-method "GET")
             (url-request-data nil)
             (url-request-noninteractive t)
             (url-request-extra-headers org-social-file--no-cache-headers)
             (buffer (url-retrieve-synchronously
                      (org-social-file--no-cache-url url) t nil 10)))
        (when buffer
          (unwind-protect
              (with-current-buffer buffer
                (let ((response (org-social-file--parse-response)))
                  (and (plist-get response :status) response)))
            (kill-buffer buffer))))
    (error
     (message "Error downloading %s: %s" url (error-message-string err))
     nil)))

(defun org-social-file--download-vfile (public-url callback)
  "Download the file from PUBLIC-URL asynchronously, bypassing caches.
Calls CALLBACK with the content and its ETag on success, or with nil
and nil on error.
Note: Despite the function name, this downloads from the public URL, not vfile."
  (message "Downloading file from %s..." public-url)
  (org-social-file--fetch-remote
   public-url
   (lambda (response)
     (if (org-social-file--response-ok-p response)
         (funcall callback (plist-get response :body) (plist-get response :etag))
       (message "Error downloading vfile (status %s)"
                (or (plist-get response :status) "unknown"))
       (funcall callback nil nil)))))

(defun org-social-file--download-vfile-sync (public-url)
  "Download the file from PUBLIC-URL synchronously, bypassing caches.
Returns the downloaded content as a string, or nil on error.
Note: Despite the function name, this downloads from the public URL, not vfile."
  (let ((response (org-social-file--fetch-remote-sync public-url)))
    (if (org-social-file--response-ok-p response)
        (plist-get response :body)
      (message "Error downloading vfile synchronously (status %s)"
               (or (plist-get response :status) "unknown"))
      nil)))

;;;; Keeping the local copy in sync with the host

(defun org-social-file--revert-visiting-buffer (local-path &optional force)
  "Reload the buffer visiting LOCAL-PATH if the file changed on disk.
With FORCE, reload it even if the modification time looks unchanged.
Buffers with unsaved changes are never reloaded."
  (let ((buf (find-buffer-visiting local-path)))
    (when (and buf
               (not (buffer-modified-p buf))
               (or force (not (verify-visited-file-modtime buf))))
      (with-current-buffer buf
        (revert-buffer t t t)))))

(defun org-social-file--resolve-unsaved-changes (local-path)
  "Make sure reloading LOCAL-PATH from the host cannot lose unsaved edits.
If a buffer visits LOCAL-PATH with unsaved changes, ask whether to save
them first (they are then uploaded as usual), discard them, or abort
with a `user-error'."
  (let ((buf (find-buffer-visiting local-path)))
    (when (and buf (buffer-modified-p buf))
      (pcase (car (read-multiple-choice
                   (format "%s has unsaved changes" (buffer-name buf))
                   '((?s "save" "Save and upload them, then reload from the host")
                     (?d "discard" "Discard them and reload from the host")
                     (?a "abort" "Do nothing"))))
        (?s (with-current-buffer buf
              (org-social-file--save-and-sync)))
        (?d (with-current-buffer buf
              (revert-buffer t t t)))
        (_ (user-error "Aborted: %s has unsaved changes" (buffer-name buf)))))))

(defun org-social-file--apply-remote (local-path remote-content remote-etag)
  "Bring LOCAL-PATH up to date with REMOTE-CONTENT served with REMOTE-ETAG.
Local changes that were saved but never uploaded are not overwritten.
Return `updated' when LOCAL-PATH now holds the remote version,
`local-ahead' when LOCAL-PATH has unuploaded changes on top of the
remote version (they are uploaded now), or `conflict' when both
changed (see `org-social-file--handle-conflict')."
  (let* ((local (org-social-file--read-local local-path))
         (local-sha (and local (org-social-file--sha256 local)))
         (base-sha (plist-get (org-social-file--read-base local-path) :sha256))
         (remote-sha (org-social-file--sha256 remote-content))
         (buf (find-buffer-visiting local-path)))
    (cond
     ;; Edited while the download was running: keep both versions.
     ((and buf (buffer-modified-p buf) local
           (not (equal local-sha remote-sha)))
      (org-social-file--handle-conflict local-path remote-content remote-etag)
      'conflict)
     ((and local base-sha
           (not (equal local-sha base-sha))
           (not (equal local-sha remote-sha)))
      (if (equal remote-sha base-sha)
          (progn
            (message "Uploading local changes that were not on the host yet...")
            (org-social-file--upload-vfile org-social-file local-path)
            'local-ahead)
        (org-social-file--handle-conflict local-path remote-content remote-etag)
        'conflict))
     (t
      (let ((changed (not (equal local-sha remote-sha))))
        (when changed
          (org-social-file--write-local local-path remote-content))
        (org-social-file--write-base local-path remote-etag remote-content)
        (org-social-file--revert-visiting-buffer local-path changed))
      'updated))))

(defun org-social-file--refresh-vfile-cache ()
  "Download the vfile feed synchronously and update the local copy.
Unsaved changes in the local copy are handled first with
`org-social-file--resolve-unsaved-changes'.  Return the result of
`org-social-file--apply-remote', or nil if the host could not be
reached (the local copy is then left as is)."
  (let ((local-path (org-social-file--get-local-file-path org-social-file)))
    (org-social-file--resolve-unsaved-changes local-path)
    (message "Syncing from remote...")
    (let ((response (org-social-file--fetch-remote-sync org-social-my-public-url)))
      (if (org-social-file--response-ok-p response)
          (prog1 (org-social-file--apply-remote local-path
                                                (plist-get response :body)
                                                (plist-get response :etag))
            (message "Syncing from remote...done"))
        (message "Warning: remote unreachable, using local version.")
        nil))))

;;;; Upload

(defun org-social-file--state (local-path)
  "Return the upload state plist of LOCAL-PATH."
  (gethash (expand-file-name local-path) org-social-file--upload-state))

(defun org-social-file--set-state (local-path &rest props)
  "Set the upload state PROPS (a plist) of LOCAL-PATH."
  (let* ((key (expand-file-name local-path))
         (state (gethash key org-social-file--upload-state)))
    (while props
      (setq state (plist-put state (pop props) (pop props))))
    (puthash key state org-social-file--upload-state))
  (force-mode-line-update t))

(defun org-social-file--upload-running-p (local-path)
  "Return non-nil if an upload of LOCAL-PATH is running."
  (let ((state (org-social-file--state local-path)))
    (and (eq (plist-get state :status) 'uploading)
         (plist-get state :started)
         (< (- (float-time) (plist-get state :started))
            org-social-file--upload-timeout))))

(defun org-social-file--upload-succeeded (local-path)
  "Mark the upload of LOCAL-PATH as done and run any pending upload."
  (let ((pending (plist-get (org-social-file--state local-path) :pending)))
    (org-social-file--set-state local-path :status nil :started nil :pending nil)
    (when pending
      (org-social-file--upload-vfile pending local-path))))

(defun org-social-file--upload-failed (local-path reason &optional http-status body)
  "Report that the upload of LOCAL-PATH failed because of REASON.
HTTP-STATUS and BODY are the host answer, if any.  The failure is shown
with `display-warning' and the buffer mode line until a later upload
succeeds; the next save tries again."
  (org-social-file--set-state local-path :status 'failed :started nil :pending nil)
  (display-warning
   'org-social
   (format "Upload of %s to the host failed%s: %s.%s\nYour changes are safe in that file; they will be uploaded again the next time you save it."
           (abbreviate-file-name local-path)
           (if http-status (format " (HTTP %s)" http-status) "")
           reason
           (if (and body (not (string-empty-p (string-trim body))))
               (format "\nHost answer: %s"
                       (truncate-string-to-width (string-trim body) 500))
             ""))
   :error))

(defun org-social-file--conflict-file-name (local-path)
  "Return a new file name to keep the local version of LOCAL-PATH."
  (let* ((stem (format "%s.conflict-%s" local-path
                       (format-time-string "%Y%m%dT%H%M%S")))
         (name stem)
         (n 1))
    (while (file-exists-p name)
      (setq name (format "%s-%d" stem n)
            n (1+ n)))
    name))

(defun org-social-file--open-conflict-ediff (conflict-file local-path)
  "Compare CONFLICT-FILE (local version) and LOCAL-PATH (host version)."
  (require 'ediff)
  (ediff-files conflict-file local-path))

(defun org-social-file--handle-conflict (local-path remote-content remote-etag
                                                    &optional local-content)
  "Keep both versions when LOCAL-PATH and the host changed independently.
The local version is copied to LOCAL-PATH.conflict-TIMESTAMP: it is
LOCAL-CONTENT when non-nil, otherwise the buffer visiting LOCAL-PATH
\(including unsaved changes) or the file itself.  LOCAL-PATH gets the
host version REMOTE-CONTENT served with REMOTE-ETAG, a warning explains
what happened and, if `org-social-vfile-conflict-ediff' is non-nil,
`ediff' compares both files.  Return the conflict file name."
  (let* ((buf (find-buffer-visiting local-path))
         (local (cond
                 (local-content)
                 (buf (with-current-buffer buf
                        (buffer-substring-no-properties (point-min) (point-max))))
                 (t (org-social-file--read-local local-path))))
         (conflict-file (org-social-file--conflict-file-name local-path)))
    (org-social-file--write-local conflict-file (or local ""))
    (org-social-file--write-local local-path remote-content)
    (org-social-file--write-base local-path remote-etag remote-content)
    (when buf
      (with-current-buffer buf
        (revert-buffer t t t)))
    (org-social-file--set-state local-path
                                :status 'conflict :started nil :pending nil
                                :inserted-ids nil
                                :conflict-file conflict-file)
    (display-warning
     'org-social
     (format "Your feed changed on the host since Emacs downloaded it, probably because you published from another client.  Nothing was uploaded, so those posts were not deleted.
- Your version is saved in %s
- %s now has the version from the host
Copy your changes into %s (ediff opens both files, your version is A) and save it to upload them.  To overwrite the host with your version instead, losing what was published elsewhere, run C-u M-x org-social-force-upload."
             (abbreviate-file-name conflict-file)
             (abbreviate-file-name local-path)
             (file-name-nondirectory local-path))
     :error)
    (when (and (boundp 'org-social-vfile-conflict-ediff)
               org-social-vfile-conflict-ediff)
      (run-at-time 0 nil #'org-social-file--open-conflict-ediff
                   conflict-file local-path))
    conflict-file))

(defun org-social-file--fetch-and-handle-conflict (local-path local-content)
  "Download the feed and keep it and LOCAL-CONTENT as a conflict of LOCAL-PATH.
LOCAL-CONTENT may be nil to use the local copy, see
`org-social-file--handle-conflict'."
  (org-social-file--fetch-remote
   org-social-my-public-url
   (lambda (remote)
     (if (org-social-file--response-ok-p remote)
         (org-social-file--handle-conflict local-path
                                           (plist-get remote :body)
                                           (plist-get remote :etag)
                                           local-content)
       (org-social-file--upload-failed
        local-path
        "your feed changed on the host and could not be downloaded to compare it"
        (plist-get remote :status) (plist-get remote :body))))))

;;;; Post IDs

(defconst org-social-file--timestamp-regexp
  (concat "[0-9]\\{4\\}-[0-9]\\{2\\}-[0-9]\\{2\\}T[0-9]\\{2\\}:[0-9]\\{2\\}:[0-9]\\{2\\}"
          "\\(?:Z\\|[+-][0-9]\\{2\\}:?[0-9]\\{2\\}\\)")
  "Regexp matching a post ID (an RFC 3339 timestamp).")

(defun org-social-file--post-ids (content)
  "Return the post IDs found in CONTENT, in the header or in properties."
  (let ((ids '())
        (start 0)
        (regexp (format "^\\(?:\\*\\*[ \t]+\\|:ID:[ \t]*\\)\\(%s\\)[ \t]*$"
                        org-social-file--timestamp-regexp)))
    (while (string-match regexp content start)
      (push (match-string 1 content) ids)
      (setq start (match-end 0)))
    ids))

(defun org-social-file--timestamp-add-second (timestamp)
  "Return TIMESTAMP plus one second, keeping its time zone and format."
  (let* ((time (parse-iso8601-time-string timestamp))
         (utc (string-suffix-p "Z" timestamp))
         (offset (if (string-match "\\([+-]\\)\\([0-9]\\{2\\}\\):?\\([0-9]\\{2\\}\\)\\'" timestamp)
                     (* (if (equal (match-string 1 timestamp) "-") -1 1)
                        (+ (* 3600 (string-to-number (match-string 2 timestamp)))
                           (* 60 (string-to-number (match-string 3 timestamp)))))
                   0))
         (next (format-time-string "%FT%T%z" (time-add time 1) offset)))
    (cond
     (utc (concat (substring next 0 -5) "Z"))
     ((string-match-p ":[0-9]\\{2\\}\\'" (substring timestamp -3))
      (concat (substring next 0 -2) ":" (substring next -2)))
     (t next))))

(defun org-social-file--unique-timestamp (timestamp taken)
  "Return TIMESTAMP, or the next free second if it is in the list TAKEN.
Two posts of a feed cannot share an ID."
  (let ((ts timestamp))
    (while (member ts taken)
      (setq ts (org-social-file--timestamp-add-second ts)))
    ts))

(defun org-social-file--new-timestamp ()
  "Return a post ID for a new post in the current buffer.
It is the current time, moved forward if a post already uses it.  When
the buffer is the vfile local copy, the ID is remembered so that the
post can be added again on top of the host version if saving it hits a
conflict (see `org-social-file--package-blocks')."
  (let ((id (org-social-file--unique-timestamp
             (org-social-parser--generate-timestamp)
             (org-social-file--post-ids
              (buffer-substring-no-properties (point-min) (point-max))))))
    (when (and buffer-file-name
               (boundp 'org-social-file)
               (org-social-file--is-vfile-p org-social-file)
               (file-equal-p buffer-file-name
                             (org-social-file--get-local-file-path org-social-file)))
      (org-social-file--set-state
       buffer-file-name :inserted-ids
       (cons id (plist-get (org-social-file--state buffer-file-name) :inserted-ids))))
    id))

;;;; Package actions

(defconst org-social-file--action-attempts 3
  "Uploads tried by a package action before reporting a conflict.")

(defconst org-social-file--action-retry-delays '(0.3 1.0)
  "Seconds to wait before each new attempt of a package action.")

(defun org-social-file--post-block-regexp (id)
  "Return a regexp matching the header line of the post with ID."
  (format "^\\*\\*[ \t]+%s[ \t]*$" (regexp-quote id)))

(defun org-social-file--normalize (content)
  "Return CONTENT without trailing spaces and repeated blank lines."
  (let ((text (replace-regexp-in-string "[ \t]+$" "" content)))
    (string-trim (replace-regexp-in-string "\n\\{3,\\}" "\n\n" text))))

(defun org-social-file--extract-blocks (content ids)
  "Split the posts with IDS out of CONTENT.
Return a cons (REST . BLOCKS): CONTENT without those posts, and the
text of each post found, in order of appearance."
  (with-temp-buffer
    (insert content)
    (let ((ranges '()))
      (dolist (id ids)
        (goto-char (point-min))
        (when (re-search-forward (org-social-file--post-block-regexp id) nil t)
          (let ((start (line-beginning-position)))
            (forward-line 1)
            (push (cons start
                        (if (re-search-forward "^\\*\\{1,2\\}\\(?:[ \t]\\|$\\)" nil t)
                            (line-beginning-position)
                          (point-max)))
                  ranges))))
      (setq ranges (sort ranges (lambda (a b) (< (car a) (car b)))))
      (let ((blocks (mapcar (lambda (range)
                              (string-trim-right
                               (buffer-substring-no-properties (car range) (cdr range))))
                            ranges)))
        (dolist (range (reverse ranges))
          (delete-region (car range) (cdr range)))
        (cons (buffer-string) blocks)))))

(defun org-social-file--package-blocks (local-path content)
  "Return the posts added by the package if that is all CONTENT changes.
CONTENT is the local version of LOCAL-PATH.  The posts are the ones inserted by
`org-social-file--new-timestamp' (new posts, replies, reactions,
boosts, polls, migrations), possibly with text written in them.
Return nil if anything else differs from the version downloaded from
the host, which means the file was edited by hand."
  (let ((ids (plist-get (org-social-file--state local-path) :inserted-ids))
        (base (plist-get (org-social-file--read-base local-path) :content)))
    (when (and ids (stringp base))
      (let ((split (org-social-file--extract-blocks content ids)))
        (when (and (cdr split)
                   (equal (org-social-file--normalize (car split))
                          (org-social-file--normalize base)))
          (cdr split))))))

(defun org-social-file--append-to-posts (content block)
  "Return CONTENT with the post BLOCK added at the end of its Posts section."
  (let ((text (string-trim-right content)))
    (unless (string-match-p "^\\* Posts[ \t]*$" text)
      (setq text (concat text "\n\n* Posts")))
    (concat text
            (if (string-match-p "^\\* Posts[ \t]*\\'" text) "\n" "\n\n")
            (string-trim-right block)
            "\n")))

(defun org-social-file--append-new-post (content make-block)
  "Return CONTENT with a new post at the end.
MAKE-BLOCK is called with a post ID that is the current time, moved
forward if CONTENT already has a post with it, and returns the post."
  (org-social-file--append-to-posts
   content
   (funcall make-block
            (org-social-file--unique-timestamp
             (org-social-parser--generate-timestamp)
             (org-social-file--post-ids content)))))

(defun org-social-file--append-blocks-transform (blocks)
  "Return a function adding the posts BLOCKS to the feed it receives.
Each post keeps its ID unless the feed already has a post with it, in
which case the next free second is used."
  (lambda (content)
    (let ((taken (org-social-file--post-ids content))
          (result content))
      (dolist (block blocks)
        (let* ((id-end (and (string-match (format "\\`\\*\\*[ \t]+\\(%s\\)"
                                                  org-social-file--timestamp-regexp)
                                          block)
                            (match-end 1)))
               (id (and id-end (match-string 1 block)))
               (new-id (and id (org-social-file--unique-timestamp id taken))))
          (when new-id
            (push new-id taken)
            (unless (equal id new-id)
              (setq block (concat "** " new-id (substring block id-end)))))
          (setq result (org-social-file--append-to-posts result block))))
      result)))

(defun org-social-file--store-uploaded (local-path content etag)
  "Record that the host now has CONTENT, served with ETAG, for LOCAL-PATH.
The local copy and the buffer visiting it are updated unless the
buffer has unsaved changes."
  (let ((buf (find-buffer-visiting local-path))
        (uploaded-ids (org-social-file--post-ids content)))
    (if (and buf (buffer-modified-p buf))
        (unless (equal (org-social-file--read-local local-path) content)
          (display-warning
           'org-social
           (format "%s was uploaded while it had unsaved changes.  Revert it (M-x revert-buffer) to see the uploaded version before saving again."
                   (buffer-name buf))
           :warning))
      (unless (equal (org-social-file--read-local local-path) content)
        (org-social-file--write-local local-path content)
        (org-social-file--revert-visiting-buffer local-path t)))
    (org-social-file--write-base local-path etag content)
    (org-social-file--set-state
     local-path :inserted-ids
     (seq-remove (lambda (id) (member id uploaded-ids))
                 (plist-get (org-social-file--state local-path) :inserted-ids)))))

(defun org-social-file--keep-action-locally (local-path remote remote-etag new)
  "Keep NEW in LOCAL-PATH so that it is uploaded later.
REMOTE, served with REMOTE-ETAG, is the feed NEW was built on.  Skipped
when the buffer visiting LOCAL-PATH has unsaved changes."
  (let ((buf (find-buffer-visiting local-path)))
    (unless (and buf (buffer-modified-p buf))
      (org-social-file--write-base local-path remote-etag remote)
      (org-social-file--write-local local-path new)
      (org-social-file--revert-visiting-buffer local-path t))))

(defun org-social-file--run-action (vfile-url local-path transform
                                              &optional done attempt)
  "Apply TRANSFORM to the feed on the host of VFILE-URL and upload it.
TRANSFORM receives the feed content and returns the new content.  The
upload sends If-Match; when the host answers 412 because the feed
changed meanwhile, TRANSFORM runs again on the new feed, up to
`org-social-file--action-attempts' uploads, waiting a little longer
each time.  Then the conflict is handled by
`org-social-file--handle-conflict'.  On success LOCAL-PATH gets the
result and DONE, if non-nil, is called with it.  ATTEMPT is the number
of this upload, 1 by default."
  (let ((attempt (or attempt 1))
        (public-url org-social-my-public-url))
    (org-social-file--set-state local-path
                                :status 'uploading :started (float-time))
    (org-social-file--fetch-remote
     public-url
     (lambda (response)
       (if (not (org-social-file--response-ok-p response))
           (org-social-file--upload-failed
            local-path "could not download your feed before changing it"
            (plist-get response :status) (plist-get response :body))
         (let* ((remote (plist-get response :body))
                (remote-etag (plist-get response :etag))
                (new (funcall transform remote)))
           (if (equal new remote)
               (progn
                 (org-social-file--store-uploaded local-path remote remote-etag)
                 (org-social-file--upload-succeeded local-path)
                 (when done (funcall done remote)))
             (org-social-file--post-content
              vfile-url new remote-etag
              (lambda (post)
                (let ((status (plist-get post :status)))
                  (cond
                   ((and status (>= status 200) (< status 300))
                    (org-social-file--store-uploaded local-path new (plist-get post :etag))
                    (org-social-file--upload-succeeded local-path)
                    (message "File uploaded successfully to host")
                    (when done (funcall done new)))
                   ((and (eql status 412)
                         (< attempt org-social-file--action-attempts))
                    (run-at-time (nth (1- attempt) org-social-file--action-retry-delays)
                                 nil #'org-social-file--run-action
                                 vfile-url local-path transform done (1+ attempt)))
                   ((eql status 412)
                    (org-social-file--fetch-and-handle-conflict local-path new))
                   (t
                    (org-social-file--keep-action-locally local-path remote remote-etag new)
                    (org-social-file--report-post-failure local-path status
                                                          (plist-get post :body))))))))))))))

(defun org-social-file--report-post-failure (local-path status body)
  "Report the failed upload of LOCAL-PATH with HTTP STATUS and BODY."
  (cond
   ((eql status 401)
    (org-social-file--upload-failed
     local-path
     "the vfile URL is invalid or incomplete, copy it again from your other client"
     status body))
   (status
    (org-social-file--upload-failed local-path "the host rejected the upload"
                                    status body))
   (t
    (org-social-file--upload-failed local-path "the host could not be reached"))))

(defun org-social-file--start-action (vfile-url local-path transform done)
  "Run `org-social-file--run-action' once no other upload is running.
VFILE-URL, LOCAL-PATH, TRANSFORM and DONE are passed to it."
  (if (org-social-file--upload-running-p local-path)
      (run-at-time 0.5 nil #'org-social-file--start-action
                   vfile-url local-path transform done)
    (org-social-file--run-action vfile-url local-path transform done)))

(defun org-social-file--apply-action (transform &optional done)
  "Change your feed with TRANSFORM, without losing posts published elsewhere.
TRANSFORM is a function that receives the content of the feed and
returns the new content; it must only add or change what the action
needs (a post, a FOLLOW line...).  With a vfile, it runs on the latest
version downloaded from the host and the result is uploaded
asynchronously, retrying on conflicts (see
`org-social-file--run-action').  With a local file, the file is changed
and saved.  DONE, if non-nil, is called with the new content.
Signal a `user-error', changing nothing, if the buffer visiting the
feed has unsaved changes: they are not mixed with the action."
  (org-social-file--check-config)
  (let* ((vfile (org-social-file--is-vfile-p org-social-file))
         (local-path (if vfile
                         (org-social-file--get-local-file-path org-social-file)
                       (expand-file-name org-social-file)))
         (buf (find-buffer-visiting local-path)))
    (when (and buf (buffer-modified-p buf))
      (user-error "%s has unsaved changes: save or revert it first, nothing was changed"
                  (buffer-name buf)))
    (if vfile
        (org-social-file--start-action org-social-file local-path transform done)
      (unless (file-exists-p local-path)
        (user-error "File %s does not exist" local-path))
      (with-current-buffer (find-file-noselect local-path)
        (let* ((old (buffer-substring-no-properties (point-min) (point-max)))
               (new (funcall transform old)))
          (unless (equal old new)
            (erase-buffer)
            (insert new)
            (save-buffer)
            (unless (memq #'org-social-file--auto-save after-save-hook)
              (org-social-file--auto-save)))
          (when done (funcall done new)))))))

(defun org-social-file--rebase-or-conflict (vfile-url local-path content attempt)
  "Handle a conflict while uploading CONTENT, the local copy LOCAL-PATH.
If CONTENT only adds posts created by the package to the version
downloaded from the host, add them again on top of the host version
of VFILE-URL with `org-social-file--run-action' (ATTEMPT is its first upload
number).  Otherwise the file was edited by hand: keep both versions
with `org-social-file--handle-conflict'."
  (let ((blocks (org-social-file--package-blocks local-path content)))
    (cond
     ((not blocks)
      (org-social-file--fetch-and-handle-conflict local-path nil))
     ((> attempt org-social-file--action-attempts)
      (org-social-file--fetch-and-handle-conflict local-path content))
     ((> attempt 1)
      ;; The previous upload was refused: wait a little before retrying
      (run-at-time (nth (- attempt 2) org-social-file--action-retry-delays)
                   nil #'org-social-file--run-action vfile-url local-path
                   (org-social-file--append-blocks-transform blocks) nil attempt))
     (t
      (org-social-file--run-action vfile-url local-path
                                   (org-social-file--append-blocks-transform blocks)
                                   nil attempt)))))

(defun org-social-file--upload-after-check (vfile-url local-path response)
  "Upload LOCAL-PATH to VFILE-URL if the feed in RESPONSE allows it.
RESPONSE is the feed just downloaded from the host.  Upload only if it
is still the version LOCAL-PATH is based on; otherwise see
`org-social-file--rebase-or-conflict'."
  (if (not (org-social-file--response-ok-p response))
      (org-social-file--upload-failed
       local-path
       "could not download your feed to check for posts published elsewhere"
       (plist-get response :status) (plist-get response :body))
    (let* ((remote (plist-get response :body))
           (remote-etag (plist-get response :etag))
           (remote-sha (org-social-file--sha256 remote))
           (local (or (org-social-file--read-local local-path) ""))
           (local-sha (org-social-file--sha256 local))
           (base-sha (plist-get (org-social-file--read-base local-path) :sha256)))
      (cond
       ;; The host already has this content.
       ((equal local-sha remote-sha)
        (org-social-file--store-uploaded local-path remote remote-etag)
        (org-social-file--upload-succeeded local-path))
       ;; No local changes, only remote ones: take them.
       ((equal local-sha base-sha)
        (org-social-file--apply-remote local-path remote remote-etag)
        (org-social-file--upload-succeeded local-path))
       ;; Only local changes: safe to upload.
       ((equal remote-sha base-sha)
        (org-social-file--post-vfile vfile-url local-path remote-etag))
       (t
        (org-social-file--rebase-or-conflict vfile-url local-path local 1))))))

(defun org-social-file--post-content (vfile-url content etag callback)
  "POST CONTENT as the feed of VFILE-URL to the upload endpoint of its host.
When ETAG is non-nil it is sent as If-Match, so the host refuses the
upload with 412 if the feed changed in the meantime.  CALLBACK receives
the plist of `org-social-file--parse-response', or nil if the host could
not be reached."
  (let* ((host-url (org-social-file--extract-host-from-vfile vfile-url))
         (upload-url (concat host-url "/upload"))
         (boundary (format "----EmacsFormBoundary%d" (random 1000000)))
         (body (concat
                "--" boundary "\r\n"
                "Content-Disposition: form-data; name=\"vfile\"\r\n\r\n"
                vfile-url "\r\n"
                "--" boundary "\r\n"
                "Content-Disposition: form-data; name=\"file\"; filename=\"social.org\"\r\n"
                "Content-Type: text/plain; charset=utf-8\r\n\r\n"
                content "\r\n"
                "--" boundary "--\r\n"))
         (url-request-method "POST")
         ;; Never prompt for a user and password when the host answers 401
         (url-request-noninteractive t)
         (url-request-extra-headers
          `(("Content-Type" . ,(format "multipart/form-data; boundary=%s" boundary))
            ,@(when etag `(("If-Match" . ,etag)))))
         (url-request-data (encode-coding-string body 'utf-8-unix)))
    (message "Uploading file to %s..." host-url)
    (org-social-file--url-retrieve
     upload-url
     (lambda (_status)
       (let ((response (condition-case nil
                           (org-social-file--parse-response)
                         (error nil))))
         (kill-buffer (current-buffer))
         (funcall callback (and (plist-get response :status) response)))))))

(defun org-social-file--post-vfile (vfile-url local-path etag)
  "Upload the local copy LOCAL-PATH to the host of VFILE-URL.
ETAG is sent as If-Match when non-nil (see
`org-social-file--post-content')."
  (let ((content (or (org-social-file--read-local local-path) "")))
    (org-social-file--post-content
     vfile-url content etag
     (lambda (response)
       (let ((status (plist-get response :status)))
         (cond
          ((and status (>= status 200) (< status 300))
           (org-social-file--store-uploaded local-path content (plist-get response :etag))
           (org-social-file--upload-succeeded local-path)
           (message "File uploaded successfully to host"))
          ((eql status 412)
           (org-social-file--rebase-or-conflict vfile-url local-path content 2))
          (t
           (org-social-file--report-post-failure local-path status
                                                 (plist-get response :body)))))))))

(defun org-social-file--upload-vfile (vfile-url local-path &optional force)
  "Upload LOCAL-PATH to VFILE-URL without overwriting changes made elsewhere.
The feed is first downloaded again and compared with the version
LOCAL-PATH is based on.  If it changed (for example a post published
from another client), nothing is uploaded and both versions are kept
with `org-social-file--handle-conflict'.  With FORCE non-nil, upload
without checking.  Everything runs asynchronously; a second upload
requested while one is running waits for it to finish."
  (when (and (org-social-file--is-vfile-p vfile-url)
             (file-exists-p local-path))
    (setq vfile-url (string-trim vfile-url))
    (let ((problem (org-social-file--vfile-url-problem vfile-url))
          (public-url (and (boundp 'org-social-my-public-url)
                           org-social-my-public-url)))
      (cond
       (problem
        (org-social-file--upload-failed
         local-path
         (format "the vfile URL is invalid or incomplete (%s), copy it again from your other client"
                 problem)))
       ((not (and (stringp public-url) (not (string-empty-p public-url))))
        (org-social-file--upload-failed
         local-path "variable `org-social-my-public-url' is not set"))
       ((org-social-file--upload-running-p local-path)
        (org-social-file--set-state local-path :pending vfile-url))
       (t
        (org-social-file--set-state local-path
                                    :status 'uploading :started (float-time)
                                    :pending nil)
        (if force
            (org-social-file--post-vfile vfile-url local-path nil)
          (org-social-file--fetch-remote
           public-url
           (lambda (response)
             (org-social-file--upload-after-check vfile-url local-path response)))))))))

(defun org-social-file--sync-vfile ()
  "Upload the current social file to the host if `org-social-file' is a vfile URL.
This function is meant to be called from after-save-file-hook."
  (when (and (not org-social-file--inhibit-sync)
             (boundp 'org-social-file)
             (org-social-file--is-vfile-p org-social-file))
    (let ((local-path (org-social-file--get-local-file-path org-social-file)))
      (when (and (buffer-file-name)
                 (file-equal-p (buffer-file-name) local-path))
        (org-social-file--upload-vfile org-social-file local-path)))))

(defun org-social-file--save-and-sync ()
  "Save the current buffer and upload it once if it is the vfile copy.
The upload is triggered by `org-social-mode' hooks when they are
installed, and explicitly otherwise."
  (save-buffer)
  (unless (memq #'org-social-file--auto-save after-save-hook)
    (org-social-file--sync-vfile)))

(defun org-social-file--last-conflict-file ()
  "Return the last conflict copy of the current vfile, if it still exists."
  (when (org-social-file--is-vfile-p org-social-file)
    (let ((file (plist-get (org-social-file--state
                            (org-social-file--get-local-file-path org-social-file))
                           :conflict-file)))
      (and file (file-exists-p file) file))))

(defun org-social-file--force-upload (&optional file)
  "Upload the vfile local copy even if the feed changed on the host.
With FILE (for example a conflict copy), replace the local copy with it
first.  Posts published from other clients since the last download are
lost, so `yes-or-no-p' asks for confirmation."
  (org-social-file--check-config)
  (unless (org-social-file--is-vfile-p org-social-file)
    (user-error "Variable `org-social-file' is not a vfile URL, there is nothing to upload"))
  (let* ((local-path (org-social-file--get-local-file-path org-social-file))
         (buf (find-buffer-visiting local-path)))
    (when (org-social-file--upload-running-p local-path)
      (user-error "An upload is already running, try again in a moment"))
    (unless (file-exists-p (or file local-path))
      (user-error "File %s does not exist" (or file local-path)))
    (when (and file buf (buffer-modified-p buf))
      (user-error "Save or revert %s first" (buffer-name buf)))
    (unless (yes-or-no-p
             (format "Posts published from other clients since the last download will be lost.  Overwrite your feed on the host with %s? "
                     (abbreviate-file-name (or file local-path))))
      (user-error "Upload cancelled"))
    (cond
     (file
      (org-social-file--write-local local-path (org-social-file--read-local file))
      (org-social-file--revert-visiting-buffer local-path t))
     ((and buf (buffer-modified-p buf))
      (with-current-buffer buf
        (let ((org-social-file--inhibit-sync t))
          (save-buffer)))))
    (org-social-file--upload-vfile org-social-file local-path t)))

(defun org-social-file--ensure-vfile-downloaded ()
  "Ensure vfile is downloaded to local cache if `org-social-file' is a vfile URL.
This is called before reading the profile to ensure the file exists locally.
Returns t if file is available (either already cached or downloaded),
nil otherwise."
  (when (and (boundp 'org-social-file)
             (org-social-file--is-vfile-p org-social-file)
             (boundp 'org-social-my-public-url)
             org-social-my-public-url)
    (let ((local-path (org-social-file--get-local-file-path org-social-file)))
      (unless (file-exists-p local-path)
        (message "Downloading file from public URL for profile reading...")
        (let ((response (org-social-file--fetch-remote-sync org-social-my-public-url)))
          (when (org-social-file--response-ok-p response)
            (org-social-file--apply-remote local-path
                                           (plist-get response :body)
                                           (plist-get response :etag))
            (message "File downloaded and cached"))))
      ;; Return t if file exists now
      (file-exists-p local-path))))

(defun org-social-file--mode-line-lighter ()
  "Return the `org-social-mode' lighter, flagging failed uploads."
  (pcase (and buffer-file-name
              (plist-get (org-social-file--state buffer-file-name) :status))
    ('failed (propertize " OrgSocial[upload failed]" 'face 'error))
    ('conflict (propertize " OrgSocial[conflict]" 'face 'error))
    (_ " OrgSocial")))

;; Minor mode definition
(define-minor-mode org-social-mode
  "Minor mode for enhancing the Org-social experience."
  :lighter (:eval (org-social-file--mode-line-lighter))
  :keymap org-social-variables--mode-map
  :group 'org-social
  (if org-social-mode
      (progn
        (org-mode)
        ;; `org-mode' kills local variables, including this mode's one
        (setq org-social-mode t)
        ;; Use depth 90 to run AFTER delete-trailing-whitespace (depth 0)
        (add-hook 'before-save-hook #'org-social-file--before-save 90 t)
        (add-hook 'after-save-hook #'org-social-file--auto-save nil t))
    (remove-hook 'before-save-hook #'org-social-file--before-save t)
    (remove-hook 'after-save-hook #'org-social-file--auto-save t)))

;; Removed org-social-file--normalize-empty-headers function
;; No longer needed since all posts now have ID in header (Org Social v1.6)

(defun org-social-file--before-save ()
  "Hook run before saving Org-social files."
  ;; Currently no pre-save processing needed
  ;; This function is kept for future use if needed
  nil)

(defun org-social-file--auto-save ()
  "Auto-save handler for Org-social files."
  (let ((current-file (buffer-file-name))
        (target-file (if (org-social-file--is-vfile-p org-social-file)
                         (org-social-file--get-local-file-path org-social-file)
                       org-social-file)))
    (when (and current-file
               (file-equal-p current-file target-file))
      ;; Upload to host if it's a vfile
      (org-social-file--sync-vfile)
      ;; Run user hooks
      (run-hooks 'org-social-after-save-file-hook))))

(defun org-social-file--save ()
  "Save the current Org-social file and run associated hooks."
  (interactive)
  (let ((modified (buffer-modified-p)))
    (save-buffer)
    (cond
     ((not (memq #'org-social-file--auto-save after-save-hook))
      (org-social-file--auto-save))
     ;; Nothing to save, so no hook ran: retry a failed upload
     ((and (not modified)
           buffer-file-name
           (eq (plist-get (org-social-file--state buffer-file-name) :status)
               'failed))
      (org-social-file--sync-vfile)))))

(defun org-social-file--find-posts-section ()
  "Find or create the Posts section in the current buffer."
  (goto-char (point-min))
  (if (re-search-forward "^\\* Posts" nil t)
      (line-end-position)
    ;; If Posts section doesn't exist, create it at the end
    (goto-char (point-max))
    (unless (bolp) (insert "\n"))
    (insert "\n* Posts")
    (point)))

(defun org-social-file--insert-post-template (&optional reply-url reply-id group-context visibility extra-properties)
  "Insert a new post template at the current position.
If REPLY-URL and REPLY-ID are provided, create a reply post.
If GROUP-CONTEXT is provided, add GROUP property to the post.
If VISIBILITY is \"mention\", add VISIBILITY property to the post.
EXTRA-PROPERTIES is an optional alist of additional properties to insert,
e.g. \\='((\"BOT\" . \"chess 1.e4 e5\"))."
  (let ((timestamp (org-social-file--new-timestamp))
        (lang-value (if (and (boundp 'org-social-default-lang)
                             org-social-default-lang
                             (not (string-empty-p org-social-default-lang)))
                        org-social-default-lang
                      nil)))
    ;; Check if we need to add newlines before **
    ;; Logic:
    ;; - First post after "* Posts": no blank line
    ;; - Subsequent posts: blank line separator
    (unless (bobp)
      (let ((is-first-post (save-excursion
                             (forward-line -1)
                             (looking-at-p "^\\* Posts"))))
        (if is-first-post
            ;; First post: only add newline if not already at one
            (unless (eq (char-before) ?\n)
              (insert "\n"))
          ;; Subsequent posts: ensure blank line separator
          (if (eq (char-before) ?\n)
              ;; Already on new line, add one more for blank line
              (insert "\n")
            ;; Not on new line, add two
            (insert "\n\n")))))
    (insert (format "** %s\n:PROPERTIES:\n" timestamp))
    ;; Only insert LANG if it has a value (optional field)
    (when lang-value
      (insert (format ":LANG: %s\n" lang-value)))
    (insert ":TAGS: \n")
    (insert ":CLIENT: org-social.el\n")
    (when (and reply-url reply-id)
      (insert (format ":REPLY_TO: %s#%s\n" reply-url reply-id)))
    ;; Add GROUP property if group-context parameter is provided
    (when group-context
      (let ((group-name (alist-get 'name group-context))
            (relay-url (alist-get 'relay-url group-context)))
        (when (and group-name relay-url)
          (insert (format ":GROUP: %s %s\n" group-name relay-url)))))
    ;; Add VISIBILITY property if visibility is "mention"
    (when (and visibility (string= visibility "mention"))
      (insert ":VISIBILITY: mention\n"))
    ;; Insert any extra properties (e.g. BOT)
    (dolist (prop extra-properties)
      (insert (format ":%s: %s\n" (car prop) (cdr prop))))
    (insert ":MOOD: \n")
    (insert ":END:\n\n")
    (goto-char (point-max))))

(defun org-social-file--insert-poll-template (question options poll-end)
  "Insert a new poll template at the current position.
QUESTION is the poll question, OPTIONS is a list of poll options,
and POLL-END is the RFC 3339 formatted end time."
  (let ((timestamp (org-social-file--new-timestamp))
        (lang-value (if (and (boundp 'org-social-default-lang)
                             org-social-default-lang
                             (not (string-empty-p org-social-default-lang)))
                        org-social-default-lang
                      nil)))
    ;; Check if we need to add newlines before **
    ;; Logic:
    ;; - First post after "* Posts": no blank line
    ;; - Subsequent posts: blank line separator
    (unless (bobp)
      (let ((is-first-post (save-excursion
                             (forward-line -1)
                             (looking-at-p "^\\* Posts"))))
        (if is-first-post
            ;; First post: only add newline if not already at one
            (unless (eq (char-before) ?\n)
              (insert "\n"))
          ;; Subsequent posts: ensure blank line separator
          (if (eq (char-before) ?\n)
              ;; Already on new line, add one more for blank line
              (insert "\n")
            ;; Not on new line, add two
            (insert "\n\n")))))
    (insert (format "** %s\n:PROPERTIES:\n" timestamp))
    ;; Only insert LANG if it has a value (optional field)
    (when lang-value
      (insert (format ":LANG: %s\n" lang-value)))
    (insert ":TAGS: \n")
    (insert ":CLIENT: org-social.el\n")
    (insert (format ":POLL_END: %s\n" poll-end))
    (insert ":MOOD: \n")
    (insert ":END:\n\n")
    (insert (format "%s\n\n" question))
    (dolist (option options)
      (insert (format "- [ ] %s\n" option)))
    (insert "\n")
    (goto-char (point-max))))

(defun org-social-file--create-new-feed-file ()
  "Create a new Org-social feed file with basic template."
  (find-file org-social-file)
  (insert "#+TITLE: My Social Feed\n")
  (insert "#+NICK: YourNick\n")
  (insert "#+DESCRIPTION: A brief description about yourself\n")
  (insert "#+AVATAR: https://example.com/avatar.jpg\n")
  (insert "#+LINK: https://your-website.com\n\n")
  (insert "* Posts\n")
  ;; Set correct encoding (UTF-8 with LF line endings)
  (set-buffer-file-coding-system 'utf-8-unix)
  (org-social-mode 1)
  (goto-char (point-min))
  (search-forward "YourNick")
  (message "New Org-social feed created! Please update your profile information."))

(defun org-social-file--open-after-download (local-path)
  "Open LOCAL-PATH with `org-social-mode' after a vfile download.
The buffer, if any, was already reloaded by
`org-social-file--apply-remote' unless it had unsaved changes."
  (find-file local-path)
  (unless org-social-mode
    (org-social-mode 1))
  (org-social-file--process-migrations)
  (goto-char (point-max))
  (when (fboundp 'org-social-validator-validate-and-display)
    (require 'org-social-validator)
    (org-social-validator-validate-and-display)))

(defun org-social-file--open ()
  "Open the Org-social feed file and enable `org-social-mode'.
For vfile URLs the file is downloaded before opening, without losing
unsaved or unuploaded local changes.  If the download fails, the local
cache is used as a fallback."
  (org-social-file--check-config)
  (if (org-social-file--is-vfile-p org-social-file)
      ;; Handle vfile URL: remote is authoritative
      (let ((local-path (org-social-file--get-local-file-path org-social-file)))
        (org-social-file--resolve-unsaved-changes local-path)
        (message "Downloading from remote...")
        (org-social-file--download-vfile
         org-social-my-public-url
         (lambda (content &optional etag)
           (if content
               (progn
                 (org-social-file--apply-remote local-path content etag)
                 (org-social-file--open-after-download local-path)
                 (message "Loaded from remote. Save to sync changes back."))
             ;; Download failed: fall back to cache or offer to create new file
             (if (file-exists-p local-path)
                 (progn
                   (message "Warning: remote unreachable, opening local cache.")
                   (org-social-file--open-after-download local-path))
               (when (y-or-n-p "Failed to download vfile and no local cache.  Create new local file? ")
                 (with-temp-file local-path
                   (insert "#+TITLE: My Social Feed\n")
                   (insert "#+NICK: YourNick\n")
                   (insert "#+DESCRIPTION: A brief description about yourself\n")
                   (insert "#+AVATAR: https://example.com/avatar.jpg\n")
                   (insert "#+LINK: https://your-website.com\n\n")
                   (insert "* Posts\n")
                   (set-buffer-file-coding-system 'utf-8-unix))
                 (find-file local-path)
                 (org-social-mode 1)
                 (goto-char (point-min))
                 (search-forward "YourNick")
                 (message "New file created. Update your profile and save to sync with host.")))))))
    ;; Handle local file path
    (if (file-exists-p org-social-file)
        (progn
          (find-file org-social-file)
          (org-social-mode 1)
          ;; Process migrations before moving to end
          (org-social-file--process-migrations)
          (goto-char (point-max))
          ;; Validate file and show warnings if any
          (when (fboundp 'org-social-validator-validate-and-display)
            (require 'org-social-validator)
            (org-social-validator-validate-and-display)))
      (when (y-or-n-p (format "File %s doesn't exist.  Create it? " org-social-file))
        (org-social-file--create-new-feed-file)
        ;; Validate newly created file
        (when (fboundp 'org-social-validator-validate-and-display)
          (require 'org-social-validator)
          (org-social-validator-validate-and-display))))))

(defun org-social-file--ensure-open-and-fresh ()
  "Ensure the social file is open and current before any write operation.
For vfile URLs, always downloads from remote synchronously so concurrent
edits from other clients are incorporated before inserting new content.
Unsaved changes are never discarded silently, see
`org-social-file--resolve-unsaved-changes'.  Falls back to the local
cache if the remote is unreachable.
For local files, opens the file if not already visiting."
  (org-social-file--check-config)
  (let ((target-file (if (org-social-file--is-vfile-p org-social-file)
                         (org-social-file--get-local-file-path org-social-file)
                       org-social-file)))
    (if (org-social-file--is-vfile-p org-social-file)
        (progn
          (org-social-file--refresh-vfile-cache)
          (let ((buf (find-buffer-visiting target-file)))
            (cond
             (buf
              (with-current-buffer buf
                (unless org-social-mode
                  (org-social-mode 1))))
             ((file-exists-p target-file)
              (find-file target-file)
              (org-social-mode 1)
              (org-social-file--process-migrations))
             (t
              (user-error "Cannot reach the host and there is no local copy of your feed")))))
      (unless (and (buffer-file-name)
                   (string= (expand-file-name (buffer-file-name))
                            (expand-file-name target-file)))
        (org-social-file--open)))
    ;; Ensure the social file buffer is current and displayed, so subsequent
    ;; write operations (e.g. inserting a new post) do not run in the
    ;; read-only buffer that triggered this call (e.g. the timeline).
    (let ((buf (find-buffer-visiting target-file)))
      (when (and buf (not (eq buf (current-buffer))))
        (switch-to-buffer buf)))))

(defun org-social-file--new-post (&optional reply-url reply-id group-context extra-properties)
  "Create a new post in your Org-social feed.
If REPLY-URL and REPLY-ID are provided, create a reply post.
If GROUP-CONTEXT is provided, add GROUP property to the post.
EXTRA-PROPERTIES is an optional alist of additional properties,
e.g. \\='((\"BOT\" . \"chess 1.e4 e5\"))."
  (org-social-file--ensure-open-and-fresh)
  (let ((visibility nil))
    ;; Ask for visibility only for interactive public posts (not replies, group posts, or bot posts)
    (when (and (not reply-url) (not group-context) (not extra-properties))
      (let ((choice (completing-read "Post visibility: "
                                     '("public" "mention")
                                     nil t nil nil "public")))
        (when (string= choice "mention")
          (setq visibility "mention"))))
    (save-excursion
      (org-social-file--find-posts-section)
      (goto-char (point-max))
      (org-social-file--insert-post-template reply-url reply-id group-context visibility extra-properties))
    (goto-char (point-max))
    ;; Validate file after adding post
    (when (fboundp 'org-social-validator-validate-and-display)
      (require 'org-social-validator)
      (org-social-validator-validate-and-display))))

(defun org-social-file--new-bot-post (bot-type &optional bot-params reply-url reply-id)
  "Create a new bot post with a :BOT: property.
BOT-TYPE is the bot identifier string (e.g. \"chess\").
BOT-PARAMS is an optional string of space-separated parameters.
REPLY-URL and REPLY-ID are optional for bot reply posts."
  (let ((bot-value (if (and bot-params (not (string-empty-p bot-params)))
                       (concat bot-type " " bot-params)
                     bot-type)))
    (org-social-file--new-post reply-url reply-id nil `(("BOT" . ,bot-value)))))

(defun org-social-file--new-poll ()
  "Create a new poll in your Org-social feed.
Interactively prompts for the poll question, options, and duration."
  (interactive)
  (org-social-file--ensure-open-and-fresh)

  ;; Prompt for poll question
  (let ((question (read-string "Poll question: ")))
    (when (string-empty-p question)
      (user-error "Poll question cannot be empty"))

    ;; Collect poll options
    (let ((options '())
          (option-count 1)
          (done nil))
      (while (not done)
        (let ((option (read-string (format "Option %d (leave empty to finish): " option-count))))
          (if (string-empty-p option)
              ;; Empty option, check if we have at least 2 options
              (if (< (length options) 2)
                  (message "Need at least 2 options for a poll. Continue adding options.")
                (progn
                  ;; Reverse to maintain input order
                  (setq options (reverse options))
                  (setq done t)))
            ;; Non-empty option, add it to the list
            (push option options)
            (setq option-count (1+ option-count)))))

      ;; Prompt for poll duration
      (let* ((duration-hours (read-number "Poll duration in hours (default: 24): " 24))
             (poll-end (format-time-string "%FT%T%z"
                                           (time-add (current-time)
                                                     (seconds-to-time (* duration-hours 3600))))))

        ;; Insert the poll
        (save-excursion
          (org-social-file--find-posts-section)
          (goto-char (point-max))
          (org-social-file--insert-poll-template question options poll-end))
        (goto-char (point-max))
        (message "Poll created with %d options, ending at %s" (length options) poll-end)
        ;; Validate file after adding poll
        (when (fboundp 'org-social-validator-validate-and-display)
          (require 'org-social-validator)
          (org-social-validator-validate-and-display))))))

